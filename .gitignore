# Secrets (allow only .age encrypted files and configuration)
/secrets/*
!/secrets/*.age
!/secrets/secrets.nix
!/secrets/README.md
!/secrets/*.sh
!/secrets/keys
/secrets/keys/*
!/secrets/keys/*.pub

# Nix build outputs
**/result
**/result-*

# macOS
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride

# Editor files
*.swp
*.swo
*.swn
*~
.vscode/
.idea/
*.save

# Direnv
.direnv/
.envrc.cache

# Syncthing conflicts
*.sync-conflict-*

# Backup files
*.old
*.bak
*.backup

# Temporary files
.tmp/
*.tmp

# Claude Code session-local state
.claude/scheduled_tasks.lock
