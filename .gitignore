# Secrets (allow only .age encrypted files and configuration)
/secrets/*
!/secrets/*.age
!/secrets/secrets.nix
!/secrets/README.md
!/secrets/*.sh
!/secrets/keys
/secrets/keys/*
!/secrets/keys/*.pub

# Nix build outputs
**/result
**/result-*

# macOS
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride

# Editor files
*.swp
*.swo
*.swn
*~
.vscode/
.idea/
*.save

# Direnv
.direnv/
.envrc.cache

# Syncthing conflicts
*.sync-conflict-*

# Backup files
*.old
*.bak
*.backup

# Temporary files
.tmp/
*.tmp

# Claude Code session-local state
.claude/scheduled_tasks.lock

# Defense-in-depth: the actual local-only secrets live entirely outside the
# repo (~/.config/nix-config-local-only/), never here — see
# secrets/local-only/README.md for why. This just guards against a *.nix file
# ending up in this directory by mistake.
secrets/local-only/*.nix
